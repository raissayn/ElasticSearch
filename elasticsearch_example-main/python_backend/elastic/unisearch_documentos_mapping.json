{
  "settings": {
    "analysis": {
      "filter": {
        "pt_stop": {
          "type": "stop",
          "stopwords": "_portuguese_"
        },
        "pt_stemmer": {
          "type": "stemmer",
          "language": "light_portuguese"
        }
      },
      "analyzer": {
        "unisearch_pt": {
          "type": "custom",
          "char_filter": [
            "html_strip"
          ],
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "asciifolding",
            "pt_stop",
            "pt_stemmer"
          ]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "document_id": {
        "type": "keyword"
      },
      "source_id": {
        "type": "keyword"
      },
      "doc_type": {
        "type": "keyword"
      },
      "chunk_type": {
        "type": "keyword"
      },
      "title": {
        "type": "text",
        "analyzer": "unisearch_pt",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "section_title": {
        "type": "text",
        "analyzer": "unisearch_pt",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "content": {
        "type": "text",
        "analyzer": "unisearch_pt"
      },
      "summary": {
        "type": "text",
        "analyzer": "unisearch_pt"
      },
      "searchable_text": {
        "type": "text",
        "analyzer": "unisearch_pt"
      },
      "url": {
        "type": "keyword"
      },
      "source_file": {
        "type": "keyword"
      },
      "source_path": {
        "type": "keyword",
        "index": false
      },
      "course_name": {
        "type": "text",
        "analyzer": "unisearch_pt",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "academic_year": {
        "type": "integer"
      },
      "period": {
        "type": "keyword"
      },
      "discipline_name": {
        "type": "text",
        "analyzer": "unisearch_pt",
        "fields": {
          "keyword": {
            "type": "keyword"
          }
        }
      },
      "prerequisites": {
        "type": "keyword"
      },
      "workload_total": {
        "type": "integer"
      },
      "workload_theoretical": {
        "type": "integer"
      },
      "workload_practical": {
        "type": "integer"
      },
      "workload_activity": {
        "type": "integer"
      },
      "page_start": {
        "type": "integer"
      },
      "page_end": {
        "type": "integer"
      },
      "chunk_index": {
        "type": "integer"
      },
      "tags": {
        "type": "keyword"
      },
      "ingested_at": {
        "type": "date"
      }
    }
  }
}
